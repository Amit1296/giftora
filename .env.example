# Giftora Environment Variables
# Copy this to .env and fill in your values

# Server
NODE_ENV=production
PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgresql://giftora:password@localhost:5432/giftora

# Admin Credentials
ADMIN_USER=admin
ADMIN_PASS=your_secure_password_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Email (Nodemailer)
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_APP_PASSWORD=your_app_password
MAIL_TO=recipient@example.com

# UPI Payments (optional)
# UPI_ID=your@upi
# UPI_PAYEE_NAME=Giftora
# UPI_QR_IMAGE=path_to_qr.png
