# Normalize text files to LF in the repo and working tree.
# Prevents spurious CRLF-only "modified" noise on Windows (core.autocrlf=true).
* text=auto eol=lf

# Binary assets — never normalise line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
